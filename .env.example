APP_NAME=Sextant
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Used for links in Discord notifications.
APP_URL=http://localhost:8000
# Store everything in UTC; the browser formats times in Europe/Ljubljana.
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 9.7 LTS. The user must authenticate with caching_sha2_password
# (see docs/spikes/mysql-9.7.md). Prefer the Unix socket on the same host;
# otherwise connect over TLS by setting MYSQL_ATTR_SSL_CA.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sextant
DB_USERNAME=sextant
DB_PASSWORD=
# DB_SOCKET=/var/run/mysqld/mysqld.sock
# MYSQL_ATTR_SSL_CA=/etc/mysql/ssl/ca.pem

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Redis backs the queue (Horizon), cache and locks.
QUEUE_CONNECTION=redis
CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="sextant@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Secret: anyone holding this URL can post to the channel.
DISCORD_WEBHOOK_URL=

# Sentry covers Sextant's own errors and cron heartbeats only.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Optional response header naming the backend behind a front service,
# e.g. X-Backend. Empty = off; the backend is suggested from sibling sites.
SEXTANT_BACKEND_HEADER=

VITE_APP_NAME="${APP_NAME}"
