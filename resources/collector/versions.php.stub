<?php
/*
 * Sextant versions endpoint for {{server}} (SPEC §11.4). Generated by Sextant;
 * contains the SHA-256 hash of this server's token, never the token itself.
 *
 * Hands the collector's file to Sextant over HTTPS and nothing else.
 * Runs on PHP 7.4 and newer.
 */

$tokenHash = '{{token_hash}}';
$versionsFile = '{{file_path}}';

header('Cache-Control: no-store');

if (($_SERVER['REQUEST_METHOD'] ?? '') !== 'GET') {
    header('Allow: GET');
    http_response_code(405);
    exit;
}

$https = $_SERVER['HTTPS'] ?? '';

if ($https === '' || strtolower((string) $https) === 'off') {
    http_response_code(403);
    exit;
}

$authorization = (string) ($_SERVER['HTTP_AUTHORIZATION'] ?? $_SERVER['REDIRECT_HTTP_AUTHORIZATION'] ?? '');
$token = stripos($authorization, 'Bearer ') === 0 ? trim(substr($authorization, 7)) : '';

if ($token === '' || ! hash_equals($tokenHash, hash('sha256', $token))) {
    http_response_code(401);
    exit;
}

if (! is_readable($versionsFile)) {
    http_response_code(503);
    header('Content-Type: application/json');
    echo '{"error":"versions file missing"}';
    exit;
}

header('Content-Type: application/json');
readfile($versionsFile);
