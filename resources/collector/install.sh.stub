#!/usr/bin/env bash
#
# Sextant versions installer for {{server}} (SPEC §11.8). Generated by Sextant.
#
# Installs or updates the collector (version {{collector_version}}), its hourly cron and
# versions.php, then runs the collector once. Running it again is how a server
# gets a newer collector or a rotated token. It never edits nginx: it prints
# the location block when nginx doesn't serve it yet.
#
# Run as root, from the link Sextant copies:
#   curl -fsSL '<link>' | sudo bash

set -euo pipefail

COLLECTOR=/usr/local/bin/sextant-collect
CRON=/etc/cron.d/sextant
ENDPOINT='{{endpoint_file}}'
LOCATION='{{location}}'

# Decodes base64 into a file atomically, with the given mode.
put_file() {
    local target="$1" mode="$2" content="$3" temp

    temp="$(mktemp "${target}.XXXXXX")"
    printf '%s' "$content" | base64 -d >"$temp"
    chmod "$mode" "$temp"
    mv -f "$temp" "$target"
}

# The newest PHP-FPM socket, for the nginx block, or nothing.
fpm_socket() {
    local socket found=""

    for socket in /run/php/php*-fpm.sock; do
        if [ -S "$socket" ]; then
            found="$socket"
        fi
    done

    printf '%s' "$found"
}

# Everything runs from here, so a cut-off download runs nothing.
install_sextant() {
    local socket note=""

    if [ "$(id -u)" -ne 0 ]; then
        echo "Run as root: curl -fsSL '<link>' | sudo bash" >&2
        exit 1
    fi

    install -d -m 0755 "$(dirname "$COLLECTOR")" "$(dirname "$ENDPOINT")"
    put_file "$COLLECTOR" 0755 '{{collector}}'
    put_file "$ENDPOINT" 0644 '{{endpoint}}'
    echo "Installed collector {{collector_version}} as ${COLLECTOR} and ${ENDPOINT}."

    # An existing cron is left as it is.
    if [ ! -e "$CRON" ]; then
        printf '17 * * * * root %s\n' "$COLLECTOR" >"$CRON"
        chmod 0644 "$CRON"
        echo "Wrote the hourly cron ${CRON}."
    fi

    if ! "$COLLECTOR"; then
        echo "The collector failed; see the output above." >&2
        exit 1
    fi

    echo "Collected versions into /var/lib/sextant/versions.json (readable by every PHP-FPM user)."

    if grep -rqsF -- "$LOCATION" /etc/nginx/; then
        echo "nginx already mentions ${LOCATION}; nothing to change there."
    else
        socket="$(fpm_socket)"

        if [ -z "$socket" ]; then
            socket=/run/php/php8.3-fpm.sock
            note="   # adjust to the server's PHP-FPM socket"
        fi

        cat <<NGINX

Add this to the nginx server block the endpoint URL reaches, then run: nginx -t && systemctl reload nginx

location = ${LOCATION} {
    include fastcgi_params;
    fastcgi_param SCRIPT_FILENAME ${ENDPOINT};
    fastcgi_pass unix:${socket};${note}
}

NGINX
    fi

    echo "Done. Use Test connection in Sextant."
}

install_sextant "$@"
